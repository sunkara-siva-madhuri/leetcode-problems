class Solution:
    def isValid(self, s):
        stack = []

        brackets = {
            ')': '(',
            '}': '{',
            ']': '['
        }

        for ch in s:

            if ch in brackets:
                if not stack or stack[-1] != brackets[ch]:
                    return False

                stack.pop()

            else:
                stack.append(ch)

        return len(stack) == 0
